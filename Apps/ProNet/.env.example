# ProNet Environment Configuration Template

# Server Configuration
PRONET_HOST=127.0.0.1
PRONET_PORT=8000
PRONET_DEBUG=True

# Security & Cryptography
PRONET_SECRET_KEY=pronet_super_secret_jwt_signing_key_production_grade_local_dev_2026
